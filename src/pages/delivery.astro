---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="main">
		<header class="head">
			<h1>Delivery</h1>
			<p>Official Microsoft-aligned labs, delivered online or onsite, mapped to exam objectives.</p>
		</header>

		<section class="panel" aria-label="Delivery details">
			<ul class="list">
				<li><strong>Official labs</strong>: clean environments aligned to Microsoft courses and exams.</li>
				<li>
					<strong>Real SQL</strong>: admin, development, integration and performance patterns across on‑prem and
					Azure.
				</li>
				<li><strong>Exam-ready</strong>: map skills to objectives and practise under realistic time pressure.</li>
			</ul>
		</section>

		<p class="back">
			<a href="/">← Back to home</a>
		</p>
	</main>
</Layout>

<style>
	.main {
		max-width: 900px;
		margin: 0 auto;
		padding: 32px clamp(16px, 4vw, 40px) 56px;
		color: #e5e7eb;
	}
	.head h1 {
		margin: 0 0 8px;
		font-size: 34px;
		letter-spacing: -0.03em;
	}
	.head p {
		margin: 0 0 18px;
		color: rgba(229, 231, 235, 0.78);
		line-height: 1.6;
	}
	.panel {
		padding: 18px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}
	.list {
		margin: 0;
		padding-left: 18px;
		color: rgba(229, 231, 235, 0.82);
		line-height: 1.7;
	}
	.back {
		margin: 22px 0 0;
	}
	.back a {
		color: rgba(229, 231, 235, 0.9);
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}
</style>
