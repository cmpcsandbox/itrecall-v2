---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="main">
		<header class="head">
			<h1>Courses</h1>
			<p>Clear progression from DP‑080 to DP‑800, plus fundamentals and admin tracks.</p>
		</header>

		<section class="grid" aria-label="Course list">
			<article class="card">
				<h2>DP‑080</h2>
				<p>Transact‑SQL</p>
			</article>
			<article class="card">
				<h2>DP‑300</h2>
				<p>Azure Database Administrator Associate</p>
			</article>
			<article class="card">
				<h2>DP‑800</h2>
				<p>Develop AI‑enabled database solutions <span class="soon">Coming soon</span></p>
			</article>
			<article class="card">
				<h2>DP‑900</h2>
				<p>Database Fundamentals</p>
			</article>
			<article class="card">
				<h2>AI‑900</h2>
				<p>AI Fundamentals</p>
			</article>
			<article class="card">
				<h2>Microsoft Fabric</h2>
				<p>Exploring Fabric for modern analytics <span class="soon">Coming soon</span></p>
			</article>
		</section>

		<p class="back">
			<a href="/">← Back to home</a>
		</p>
	</main>
</Layout>

<style>
	.main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 32px clamp(16px, 4vw, 40px) 56px;
		color: #e5e7eb;
	}
	.head h1 {
		margin: 0 0 8px;
		font-size: 34px;
		letter-spacing: -0.03em;
	}
	.head p {
		margin: 0 0 18px;
		color: rgba(229, 231, 235, 0.78);
		line-height: 1.6;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 12px;
	}
	.card {
		grid-column: span 4;
		padding: 14px 14px 16px;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}
	.card h2 {
		margin: 0 0 6px;
		font-size: 16px;
	}
	.card p {
		margin: 0;
		color: rgba(229, 231, 235, 0.75);
		line-height: 1.5;
	}
	.soon {
		display: inline-block;
		margin-left: 8px;
		font-size: 12px;
		letter-spacing: 0.02em;
		padding: 3px 8px;
		border-radius: 999px;
		color: rgba(229, 231, 235, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(255, 255, 255, 0.04);
		white-space: nowrap;
	}
	.back {
		margin: 22px 0 0;
	}
	.back a {
		color: rgba(229, 231, 235, 0.9);
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}
	@media (max-width: 920px) {
		.card {
			grid-column: span 6;
		}
	}
	@media (max-width: 560px) {
		.card {
			grid-column: span 12;
		}
	}
</style>
