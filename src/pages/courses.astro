---
import Layout from '../layouts/Layout.astro';
import CourseCatalogue from '../components/CourseCatalogue.astro';
---

<Layout>
	<main class="main">
		<header class="head">
			<h1>Courses</h1>
				<p>Practical SQL, Azure, AI and Microsoft Fabric training, from foundations to role‑based pathways.</p>
			</header>

			<CourseCatalogue />

		<p class="back">
			<a href="/">← Back to home</a>
		</p>
	</main>
</Layout>

<style>
	.main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 32px clamp(16px, 4vw, 40px) 56px;
		color: #e5e7eb;
	}
	.head h1 {
		margin: 0 0 8px;
		font-size: 34px;
		letter-spacing: -0.03em;
	}
		.head p {
			margin: 0 0 28px;
		color: rgba(229, 231, 235, 0.78);
		line-height: 1.6;
	}
	.back {
		margin: 22px 0 0;
	}
	.back a {
		color: rgba(229, 231, 235, 0.9);
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}
	</style>
