---
import {
	BRAND_NAME,
	CONTACT_EMAIL,
	CONTACT_PHONE,
	LINKEDIN_PROFILE,
	MS_TRANSCRIPT,
	MCT_NAME,
	MCT_TAGLINE,
	toHttpsUrl,
	toWhatsAppChatLink,
	toWhatsAppPhoneE164,
} from '../consts';

const linkedInUrl = toHttpsUrl(LINKEDIN_PROFILE);
const transcriptUrl = toHttpsUrl(MS_TRANSCRIPT);
const whatsAppPhoneDigits = toWhatsAppPhoneE164(CONTACT_PHONE);
const whatsAppUrl = toWhatsAppChatLink(
	whatsAppPhoneDigits,
	`Hi Colin — I’d like to speak to an MCT about training.`
);
---

<div class="page">
	<header class="header">
		<a class="brand" href="/" aria-label={`${BRAND_NAME} home`}>
			<img
				class="logo"
				src="/brand/itrecall-logo.png"
				alt={`${BRAND_NAME} logo`}
				width="420"
				height="140"
				loading="eager"
				fetchpriority="high"
			/>
			<span class="brandText">
				<span class="name">
					<span class="nameIt">IT</span>
					<span class="nameRest">Recall Ltd</span>
				</span>
				<span class="tagline" aria-label="Tagline using IT as Information Technology">
					<span class="tag">See IT</span>
					<span class="tagSep" aria-hidden="true">•</span>
					<span class="tag">Retain IT</span>
					<span class="tagSep" aria-hidden="true">•</span>
					<span class="tag">Recall IT</span>
				</span>
				<span class="meta" aria-label="Partner status and lab environments">
					<span class="metaLine">Microsoft Training Services Partner (TSP)</span>
					<span class="metaLine">Official lab hosting environments</span>
				</span>
			</span>
		</a>

		<nav class="nav" aria-label="Primary">
			<a href="/courses">Courses</a>
			<a href="/delivery">Delivery</a>
			<a href="/contact">Contact</a>
		</nav>
	</header>

	<main class="main">
		<section class="hero" aria-labelledby="hero-title">
			<p class="kicker">
				SQL Server training targetted at cloud or on-premise architectures, delivered to you online or onsite
			</p>
			<h1 id="hero-title">{MCT_TAGLINE}</h1>
			<p class="sublede">
				DP‑080 (Transact‑SQL) → DP‑800 (latest AI additions).
			</p>
			<p class="lede">
				Practical, confidence-building training from <strong>{MCT_NAME}</strong> (a Microsoft Certified
				Trainer with 25 years of continuous technical teaching).
			</p>
			<p class="lede lede2">
				Work towards <strong>official Microsoft certifications</strong> with exam-aligned teaching and labs.
			</p>

			<div class="ctaRow">
				<a class="btn outline" href={linkedInUrl} target="_blank" rel="noreferrer">
					Reviews on LinkedIn
				</a>
				<a class="btn subtle" href={transcriptUrl} target="_blank" rel="noreferrer">
					Verify Instructor Details
				</a>
				<a class="btn primary" href={whatsAppUrl} target="_blank" rel="noreferrer">
					MCT Direct (WhatsApp)
				</a>
			</div>

			<div class="trust">
				<div class="pill">Established 1999</div>
				<div class="pill">Real-world, exam-aligned</div>
				<div class="pill">On‑prem + Azure</div>
			</div>
		</section>

		<section id="courses" class="section" aria-labelledby="courses-title">
			<div class="sectionHead">
				<h2 id="courses-title">Popular courses</h2>
				<p>Firm foundations, then clear progression — from DP‑080 to DP‑800.</p>
			</div>

			<div class="grid">
				<article class="card">
					<h3>DP‑300</h3>
					<p>Azure Database Administrator Associate</p>
				</article>
				<article class="card">
					<h3>DP‑080</h3>
					<p>Transact‑SQL</p>
				</article>
				<article class="card">
					<h3>DP‑800</h3>
					<p>
						Develop AI‑enabled database solutions <span class="soon">Coming soon</span>
					</p>
				</article>
				<article class="card">
					<h3>DP‑900</h3>
					<p>Database Fundamentals</p>
				</article>
				<article class="card">
					<h3>AI‑900</h3>
					<p>AI Fundamentals</p>
				</article>
				<article class="card">
					<h3>Microsoft Fabric</h3>
					<p>
						Exploring Fabric for modern analytics <span class="soon">Coming soon</span>
					</p>
				</article>
			</div>
		</section>

		<section id="delivery" class="section" aria-labelledby="delivery-title">
			<div class="twoCol">
				<div class="panel">
					<h2 id="delivery-title">Official and custom delivery</h2>
					<p>
						Official Microsoft courses support exam success, while specialist SQL Server training builds
						expertise from entry‑level skills to advanced administration and development.
					</p>
					<ul class="list">
						<li><strong>Official labs</strong>: clean environments aligned to Microsoft courses and exams.</li>
						<li><strong>Real SQL</strong>: admin, development, integration and performance patterns.</li>
						<li><strong>Exam-ready</strong>: map skills to objectives and practise under realistic time pressure.</li>
					</ul>
				</div>

				<div class="panel accent">
					<h2>Core values</h2>
					<ul class="list">
						<li><strong>Trust</strong> through verifiable credentials.</li>
						<li><strong>Practicality</strong>: training that maps to real environments.</li>
						<li><strong>Support</strong>: calm, encouraging teaching for beginners and pros alike.</li>
					</ul>
					<div class="miniCtas">
						<a class="textLink" href={linkedInUrl} target="_blank" rel="noreferrer">LinkedIn reviews</a>
						<span class="sep" aria-hidden="true">·</span>
						<a class="textLink" href={transcriptUrl} target="_blank" rel="noreferrer">Certifications</a>
					</div>
				</div>
			</div>
		</section>

		<section id="contact" class="section" aria-labelledby="contact-title">
			<div class="contactCard">
				<h2 id="contact-title">Contact</h2>
				<p>
					We’d be delighted to discuss your training needs. For the fastest response, message the trainer
					directly.
				</p>
				<div class="contactRow">
					<a class="btn primary" href={whatsAppUrl} target="_blank" rel="noreferrer">
						MCT Direct (WhatsApp)
					</a>
					<a class="btn outline" href={`mailto:${CONTACT_EMAIL}`}>Email {CONTACT_EMAIL}</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<p>
			© {new Date().getFullYear()} {BRAND_NAME}. Reading, UK.
		</p>
	</footer>
</div>

<style>
	.page {
		--bg0: #0b0d10;
		--bg1: #070b14;
		--text: #e5e7eb;
		--muted: rgba(229, 231, 235, 0.78);
		--line: rgba(255, 255, 255, 0.12);
		--panel: rgba(255, 255, 255, 0.04);
		--accentBlue: #2aa7ff; /* logo-aligned electric blue */
		--accentBlue2: #66ccff; /* lighter blue highlight */
		--accentTeal: #35c9c2; /* restrained teal for secondary accents */

		min-height: 100%;
		font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell,
			Noto Sans, Helvetica, Arial, 'Apple Color Emoji', 'Segoe UI Emoji';
		color: var(--text);
		background:
			radial-gradient(900px 700px at 10% 0%, rgba(42, 167, 255, 0.22), transparent 60%),
			radial-gradient(900px 700px at 100% 10%, rgba(34, 197, 94, 0.14), transparent 60%),
			linear-gradient(180deg, var(--bg0) 0%, var(--bg1) 100%);
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 22px clamp(16px, 4vw, 40px);
		background:
			radial-gradient(700px 220px at 0% 0%, rgba(42, 167, 255, 0.22), transparent 60%),
			radial-gradient(700px 220px at 100% 0%, rgba(34, 197, 94, 0.14), transparent 60%),
			linear-gradient(180deg, rgba(11, 13, 16, 0.98) 0%, rgba(11, 13, 16, 0.88) 100%);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		text-decoration: none;
		color: inherit;
	}

	.brandText {
		display: flex;
		flex-direction: column;
		gap: 3px;
		line-height: 1.1;
		min-height: 140px;
		justify-content: center;
		align-items: center;
		text-align: center;
	}

	.logo {
		/* Hard-size to prevent layout jank/ghosting on refresh */
		width: min(70vw, 420px);
		height: 140px; /* match original itrecall.com header weight */
		max-width: 520px;
		display: block;
		border-radius: 0;
		background: transparent;
		border: none;
		object-fit: contain;
		padding: 0;
	}

	.name {
		font-weight: 750;
		font-size: 36px;
		letter-spacing: -0.02em;
		display: inline-flex;
		align-items: baseline;
		gap: 4px;
		white-space: nowrap;
	}

	.nameIt {
		color: var(--accentBlue);
		letter-spacing: -0.03em;
	}

	.nameRest {
		color: rgba(229, 231, 235, 0.92);
	}

	.tagline {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accentBlue);
		padding: 0;
		border-radius: 0;
		border: none;
		background: transparent;
	}

	.tagSep {
		color: var(--accentBlue);
	}

	.meta {
		display: flex;
		flex-direction: column;
		gap: 1px;
		color: rgba(229, 231, 235, 0.62);
		font-size: 11px;
		line-height: 1.25;
		max-width: 40ch;
	}

	.metaLine {
		display: block;
	}

	.nav {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.nav a {
		color: rgba(229, 231, 235, 0.9);
		text-decoration: none;
		padding: 8px 10px;
		border-radius: 10px;
	}

	.nav a:hover {
		background: rgba(255, 255, 255, 0.06);
	}

	.main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 clamp(16px, 4vw, 40px) 56px;
	}

	.hero {
		padding: 36px 0 22px;
	}

	.kicker {
		margin: 0 0 10px;
		color: rgba(229, 231, 235, 0.75);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 12px;
	}

	h1 {
		margin: 0 0 12px;
		font-size: clamp(28px, 4.2vw, 48px);
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.sublede {
		margin: 0 0 12px;
		max-width: 70ch;
		color: rgba(229, 231, 235, 0.78);
		line-height: 1.6;
	}

	.lede {
		margin: 0 0 18px;
		max-width: 70ch;
		color: rgba(229, 231, 235, 0.85);
		font-size: 16px;
		line-height: 1.7;
	}

	.lede2 {
		margin-top: -10px;
		color: rgba(229, 231, 235, 0.78);
	}

	.soon {
		display: inline-block;
		margin-left: 8px;
		font-size: 12px;
		letter-spacing: 0.02em;
		padding: 3px 8px;
		border-radius: 999px;
		color: rgba(229, 231, 235, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(255, 255, 255, 0.04);
		white-space: nowrap;
	}

	.ctaRow {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin: 18px 0 18px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 11px 14px;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 650;
		letter-spacing: -0.01em;
		border: 1px solid transparent;
	}

	.btn.primary {
		color: #081023;
		background: linear-gradient(90deg, var(--accentBlue) 0%, var(--accentBlue2) 100%);
	}

	.btn.outline {
		color: rgba(229, 231, 235, 0.92);
		border-color: rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.03);
	}

	.btn.subtle {
		color: rgba(229, 231, 235, 0.92);
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.12);
	}

	.btn:hover {
		filter: brightness(1.05);
	}

	.btn:focus-visible,
	.nav a:focus-visible,
	.textLink:focus-visible {
		outline: 2px solid rgba(42, 167, 255, 0.9);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			scroll-behavior: auto !important;
			transition: none !important;
		}
	}

	.trust {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.pill {
		font-size: 13px;
		padding: 7px 10px;
		border-radius: 999px;
		color: rgba(229, 231, 235, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(255, 255, 255, 0.03);
	}

	.section {
		padding: 26px 0;
		scroll-margin-top: 160px;
	}

	.sectionHead h2 {
		margin: 0 0 6px;
		font-size: 22px;
		letter-spacing: -0.02em;
	}

	.sectionHead p {
		margin: 0;
		color: rgba(229, 231, 235, 0.74);
		line-height: 1.6;
	}

	.grid {
		margin-top: 16px;
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 12px;
	}

	.card {
		grid-column: span 4;
		padding: 14px 14px 16px;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.card h3 {
		margin: 0 0 6px;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.card p {
		margin: 0;
		color: rgba(229, 231, 235, 0.75);
		line-height: 1.5;
	}

	.twoCol {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 12px;
		align-items: stretch;
	}

	.panel {
		padding: 18px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.panel.accent {
		background:
			radial-gradient(800px 400px at 0% 0%, rgba(42, 167, 255, 0.18), transparent 60%),
			rgba(255, 255, 255, 0.04);
	}

	.panel h2 {
		margin: 0 0 10px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.panel p {
		margin: 0 0 12px;
		color: rgba(229, 231, 235, 0.78);
		line-height: 1.65;
	}

	.list {
		margin: 0;
		padding-left: 18px;
		color: rgba(229, 231, 235, 0.82);
		line-height: 1.7;
	}

	.miniCtas {
		margin-top: 12px;
		color: rgba(229, 231, 235, 0.7);
	}

	.textLink {
		color: rgba(229, 231, 235, 0.92);
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}

	.sep {
		padding: 0 8px;
	}

	.contactCard {
		padding: 18px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.contactCard h2 {
		margin: 0 0 8px;
		font-size: 20px;
		letter-spacing: -0.01em;
	}

	.contactCard p {
		margin: 0 0 14px;
		color: rgba(229, 231, 235, 0.78);
		line-height: 1.65;
	}

	.contactRow {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.footer {
		padding: 18px clamp(16px, 4vw, 40px) 26px;
		max-width: 1100px;
		margin: 0 auto;
		color: rgba(229, 231, 235, 0.6);
	}

	.footer p {
		margin: 0;
	}

	@media (max-width: 920px) {
		.card {
			grid-column: span 6;
		}
		.twoCol {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.nav {
			display: none;
		}
		.header {
			padding-top: 18px;
			padding-bottom: 18px;
		}
		.logo {
			height: 110px; /* match original responsive tweak */
		}
		.name {
			font-size: 28px;
		}
		.tagline {
			font-size: 10px;
		}
		.meta {
			font-size: 12px;
		}
		.card {
			grid-column: span 12;
		}
	}
</style>
